<Window x:Class="GestionBornesCollecte.Views.ConnexionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion"
        Height="280" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F5F5">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock x:Name="txtTitreProfil"
                       FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Identifiant" Margin="0,0,0,5"/>
            <TextBox x:Name="txtLogin"
                     Width="250" Height="32"
                     FontSize="13"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Mot de passe" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtMotDePasse"
                         Width="250" Height="32"
                         FontSize="13"
                         Margin="0,0,0,12"/>

            <TextBlock x:Name="txtErreur"
                       Foreground="Red"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <Button Content="Se connecter"
                    Width="250" Height="38"
                    FontSize="14"
                    Background="#2196F3" Foreground="White"
                    BorderThickness="0"
                    Click="BtnConnexion_Click"/>

        </StackPanel>
    </Grid>
</Window>