<Window x:Class="WpfAppGestionDesBornes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppGestionDesBornes"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Name="lblConnected"/>
        <Label Grid.Row="0" Grid.Column="1" Name="lblError"/>
        <Label Grid.Row="0" Grid.Column="2" Name="lblPayload"/>
        <Label Grid.Row="1" Grid.Column="0" Name="lblBattery"/>
        <Label Grid.Row="1" Grid.Column="1" Name="lblDistance"/>
        <Label Grid.Row="1" Grid.Column="2" Name="lblTemperature"/>
    </Grid>
</Window>